<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A card is a picture inset in its frame (Card); focused, the frame shows a ring on its edge, a
         gap from the picture, and a sheen over the picture and the gap (dash_focus_ring). -->
    <dimen name="card_ring">@dimen/syn_trait_focus</dimen>
    <!-- The ring's width plus its gap from the picture: syn_trait_focus + syn_trait_focus_ecart. A dimension cannot be
         a sum of two, so the sum is written here. -->
    <!-- jeton manquant: syn_carte_inset (5) -->
    <dimen name="card_inset">5dp</dimen>
    <dimen name="card_inset_back">-5dp</dimen>
    <!-- jeton manquant: syn_carte_rayon_image (9), the picture's corner: syn_rayon_carte less the inset's 3 -->
    <dimen name="card_corner">9dp</dimen>
    <!-- The picture's corner plus the gap: the sheen's corner, and the ring's inner edge. -->
    <dimen name="card_ring_corner">@dimen/syn_rayon_carte</dimen>
    <!-- How far into a title: the bar's thickness, and the featured title's bar width. -->
    <!-- jeton manquant: syn_progression_epaisseur (3), syn_progression_largeur (160) -->
    <dimen name="progress_height">3dp</dimen>
    <dimen name="progress_width">160dp</dimen>
    <!-- jeton manquant: syn_barre_haute (72), syn_panneau_maison_largeur (288) -->
    <dimen name="top_line_height">72dp</dimen>
    <dimen name="house_panel_width">288dp</dimen>
</resources>
