<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="@color/syn_pression" android:endColor="@color/syn_survol" />
                    <corners android:radius="@dimen/syn_rayon_controle" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="@dimen/syn_focus_trait" android:color="@color/syn_encre" />
                    <corners android:radius="@dimen/syn_rayon_controle" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/syn_pression" android:endColor="@color/syn_survol" />
            <stroke android:width="@dimen/syn_trait_filet" android:color="@color/syn_filet" />
            <corners android:radius="@dimen/syn_rayon_controle" />
        </shape>
    </item>
</selector>
