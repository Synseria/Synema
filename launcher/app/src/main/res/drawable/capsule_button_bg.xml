<?xml version="1.0" encoding="utf-8"?>
<!-- A text button with round ends (the assistant's choices): glass at rest, azure when chosen, white when
     focused, like the top line's buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/syn_encre" />
            <corners android:radius="@dimen/syn_rayon_capsule" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/syn_primaire_fond" />
            <corners android:radius="@dimen/syn_rayon_capsule" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/syn_survol" />
            <stroke android:width="1dp" android:color="@color/syn_filet" />
            <corners android:radius="@dimen/syn_rayon_capsule" />
        </shape>
    </item>
</selector>
