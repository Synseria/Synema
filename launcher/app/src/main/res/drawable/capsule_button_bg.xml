<?xml version="1.0" encoding="utf-8"?>
<!-- A text button with round ends (the assistant's choices): glass at rest, lighter when chosen, white when
     focused, like the top line's buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#17FFFFFF" />
            <stroke android:width="1dp" android:color="#21FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
