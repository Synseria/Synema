<?xml version="1.0" encoding="utf-8"?>
<!-- The panel's technical corner: a shade darker than the panel; focused, a tile's veil and ring (Focus.block). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/syn_tv_fond" />
                    <corners android:radius="@dimen/syn_rayon_pastille" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/syn_pression" />
                    <stroke android:width="@dimen/syn_focus_trait" android:color="@color/syn_encre" />
                    <corners android:radius="@dimen/syn_rayon_pastille" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/syn_tv_fond" />
            <corners android:radius="@dimen/syn_rayon_pastille" />
        </shape>
    </item>
</selector>
