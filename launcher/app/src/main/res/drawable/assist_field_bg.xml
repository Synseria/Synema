<?xml version="1.0" encoding="utf-8"?>
<!-- The assistant's text field: glass with round ends, ringed while typed in. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/syn_pression" />
            <stroke android:width="@dimen/syn_trait_focus" android:color="@color/syn_encre" />
            <corners android:radius="@dimen/syn_rayon_capsule" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/syn_survol" />
            <stroke android:width="@dimen/syn_trait_filet" android:color="@color/syn_filet" />
            <corners android:radius="@dimen/syn_rayon_capsule" />
        </shape>
    </item>
</selector>
