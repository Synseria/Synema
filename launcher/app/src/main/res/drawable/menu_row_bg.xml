<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the edit panel: barely there at rest, white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/syn_encre" />
            <corners android:radius="@dimen/syn_rayon_controle" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/syn_pression" />
            <corners android:radius="@dimen/syn_rayon_controle" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/syn_survol" />
            <corners android:radius="@dimen/syn_rayon_controle" />
        </shape>
    </item>
</selector>
