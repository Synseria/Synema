<?xml version="1.0" encoding="utf-8"?>
<!-- The camera's talk button, a round secondary: surface with its outline, a white ring when focused;
     danger while the microphone is open. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/syn_danger_plein" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="@dimen/syn_trait_focus" android:color="@color/syn_encre" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/syn_danger_plein" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/syn_surface" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="@dimen/syn_trait_focus" android:color="@color/syn_encre" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/syn_surface" />
            <stroke android:width="@dimen/syn_trait_filet" android:color="@color/syn_contour_controle" />
        </shape>
    </item>
</selector>
