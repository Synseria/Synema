<?xml version="1.0" encoding="utf-8"?>
<!-- The camera's talk button: red while the microphone is open, else a white disc when focused (Focus's
     button) or glass. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/syn_danger" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/syn_encre" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/syn_tv_voile" />
            <stroke android:width="@dimen/syn_trait_filet" android:color="@color/syn_filet" />
        </shape>
    </item>
</selector>
