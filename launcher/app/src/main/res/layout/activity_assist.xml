<?xml version="1.0" encoding="utf-8"?>
<!-- The assistant (AssistActivity): a panel at the bottom of the screen over whatever was showing. Its
     buttons grow when focused (Focus): every container round them keeps clipChildren off, and the mic
     sits in a room as wide as its voice halo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="120dp"
        android:layout_marginEnd="120dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/assist_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- The assistants to talk to (home.json assistant.presets); the chosen one is lit. -->
        <LinearLayout
            android:id="@+id/presets"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginBottom="10dp"
            android:clipChildren="false"
            android:orientation="horizontal" />

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false">

            <LinearLayout
                android:id="@+id/transcript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- The mic (40dp) in a room for its halo (VoiceRing) and its lift. -->
            <FrameLayout
                android:id="@+id/micRoom"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/btnMic"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:padding="10dp"
                    android:background="@drawable/mic_button_bg"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/pill_text"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/assist_speak" />
            </FrameLayout>

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:background="@drawable/assist_field_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="@string/assist_hint"
                android:textColorHint="#FF8D9BB3"
                android:textColor="#FFF2F2F5"
                android:textSize="13sp"
                android:singleLine="true"
                android:imeOptions="actionSend"
                android:inputType="text" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="-4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:clipChildren="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
