<?xml version="1.0" encoding="utf-8"?>
<!-- An alert over any app (Alerts): live camera, title, and its buttons (enlarge, optional reply,
     close). Without a camera only the title row shows, as a small notice. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/alert_bg"
    android:elevation="12dp">

    <!-- The camera: Home Assistant's pictures at once, the WebRTC video over them from its first frame. -->
    <FrameLayout
        android:id="@+id/media"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginStart="@dimen/syn_espace_2"
        android:layout_marginTop="@dimen/syn_espace_2"
        android:layout_marginEnd="@dimen/syn_espace_2"
        android:background="@color/syn_tv_carte">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <ImageView
            android:id="@+id/frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/syn_espace_4">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Role.Titre" />

        <TextView
            android:id="@+id/countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/syn_espace_1"
            style="@style/Role.Note" />

        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="match_parent"
            android:layout_height="@dimen/syn_cible_min"
            android:layout_marginTop="@dimen/syn_espace_3"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnFull"
                style="@style/AlertButton"
                android:layout_marginEnd="@dimen/syn_espace_2"
                android:text="@string/alert_full_screen" />

            <TextView
                android:id="@+id/btnReply"
                style="@style/AlertButton"
                android:layout_marginEnd="@dimen/syn_espace_2"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnClose"
                style="@style/AlertButton"
                android:text="@string/alert_close" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
