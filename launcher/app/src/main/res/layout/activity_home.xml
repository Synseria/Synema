<?xml version="1.0" encoding="utf-8"?>
<!-- The dashboard (MainActivity), inside the TV's safe margins (Scale.marginX/Y, set in code): the top
     line (clock, date, readings, status, buttons); on the left, the featured title, then scrolling with
     focus the favourites, continue watching, what
     the apps put forward and the cameras; the House panel on the right; behind, under the window, the
     background's surface (MovingBackdrop, added in code). Rows are filled in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- The top line, at the clock's height: the time, the date, outside and the TV's room
             (HouseHeader), then the buttons. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/top_line_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:divider="@drawable/dash_column_rule"
                android:showDividers="middle"
                android:dividerPadding="@dimen/syn_espace_2">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingEnd="@dimen/syn_espace_4"
                    android:gravity="center_vertical"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textAppearance="@style/Role.GrandChiffre"
                    android:includeFontPadding="false" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/syn_espace_4"
                    android:paddingEnd="@dimen/syn_espace_4"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextClock
                        style="@style/DashCaps"
                        android:format12Hour="EEEE"
                        android:format24Hour="EEEE" />

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/syn_espace_1"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:format12Hour="d MMMM"
                        android:format24Hour="d MMMM"
                        android:textAppearance="@style/Role.CorpsFort" />
                </LinearLayout>

                <include
                    android:id="@+id/outside"
                    layout="@layout/dash_climate"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <include
                    android:id="@+id/room"
                    layout="@layout/dash_climate"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/syn_espace_1"
                android:orientation="horizontal"
                android:background="@drawable/dash_capsule_bg"
                android:divider="@drawable/dash_button_gap"
                android:showDividers="middle"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/btnAssist"
                    style="@style/IconButton"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="@string/assistant" />

                <ImageView
                    android:id="@+id/btnApps"
                    style="@style/IconButton"
                    android:src="@drawable/ic_apps"
                    android:contentDescription="@string/all_apps" />

                <ImageView
                    android:id="@+id/btnInputs"
                    style="@style/IconButton"
                    android:src="@drawable/ic_input"
                    android:contentDescription="@string/inputs" />

                <ImageView
                    android:id="@+id/btnSettings"
                    style="@style/IconButton"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/settings" />

            </LinearLayout>
        </LinearLayout>

        <!-- Under the top line: a capsule for each thing out of the ordinary, on one line, and at the right
             the focused button's name. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/syn_espace_6"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.synseria.synema.FlowRow
                android:id="@+id/statusChips"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/topCaption"
                style="@style/DashCaps"
                android:paddingStart="@dimen/syn_espace_2"
                android:gravity="end" />
        </LinearLayout>

        <!-- Its start margin, and the featured title's, give the column's padding back (MainActivity). -->
        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/syn_espace_2"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- The featured title, fixed above the rows: the selected title's words (MainActivity.feature),
                     else the newest to continue, on a veil bounded to them; its picture is the background's. -->
                <LinearLayout
                    android:id="@+id/hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/syn_espace_2"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="@dimen/syn_espace_3"
                        android:background="@drawable/dash_voile_bg"
                        android:orientation="vertical">

                        <!-- The kicker, and at its right the press's and the audience's ratings as small
                             capsules (MainActivity.showRatings), no taller than the kicker: nothing moves
                             when they come. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/heroKicker"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/syn_espace_6"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:textAppearance="@style/Role.Note" />

                            <LinearLayout
                                android:id="@+id/heroRatings"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/heroTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/syn_espace_1"
                            android:maxLines="2"
                            android:textAppearance="@style/Role.Titre" />

                        <TextView
                            android:id="@+id/heroSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textAppearance="@style/Role.Note" />

                        <TextView
                            android:id="@+id/heroDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="2"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textAppearance="@style/Role.Note" />

                        <FrameLayout
                            android:id="@+id/heroProgress"
                            android:layout_width="@dimen/progress_width"
                            android:layout_height="@dimen/progress_height"
                            android:layout_marginTop="@dimen/syn_espace_2" />
                    </LinearLayout>

                    <!-- The veil takes half of the band: a title of two lines fits it whole. -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Scrolls by whole sections under the featured title, clipped at its own top edge
                     (ColumnScroll). Its side padding is the room a focused card needs (Focus); the rows'
                     windows reach into it (CardRow), so every picture lines up with the favourites'. -->
                <com.synseria.synema.ColumnScroll
                    android:id="@+id/leftScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/syn_espace_1"
                    android:paddingTop="@dimen/syn_espace_4"
                    android:paddingBottom="@dimen/syn_espace_2"
                    android:clipToPadding="false"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:clipChildren="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:clipChildren="false">

                        <!-- Each child is a section the column scrolls to (ColumnScroll): the favourites,
                             then each row with its title. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:clipChildren="false">

                            <!-- Only while a favourite is being moved: what OK does. -->
                            <TextView
                                android:id="@+id/favLabel"
                                style="@style/DashLabel"
                                android:text="@string/edit_moving"
                                android:textColor="@color/syn_primaire_encre"
                                android:visibility="gone" />

                            <com.synseria.synema.Dock
                                android:id="@+id/dock"
                                android:background="@drawable/dash_dock_bg"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipChildren="false"
                                android:clipToPadding="false" />
                        </LinearLayout>

                        <LinearLayout style="@style/DashSection">

                            <TextView
                                android:id="@+id/resumeLabel"
                                style="@style/DashLabel"
                                android:text="@string/continue_watching" />

                            <com.synseria.synema.CardRow
                                android:id="@+id/resumeRow"
                                style="@style/DashRow" />
                        </LinearLayout>

                        <LinearLayout style="@style/DashSection">

                            <TextView
                                android:id="@+id/discoverLabel"
                                style="@style/DashLabel"
                                android:text="@string/discover" />

                            <com.synseria.synema.CardRow
                                android:id="@+id/discoverRow"
                                style="@style/DashRow" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/DashSection"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/camerasLabel"
                                style="@style/DashLabel"
                                android:text="@string/cameras" />

                            <com.synseria.synema.CardRow
                                android:id="@+id/camerasRow"
                                style="@style/DashRow" />
                        </LinearLayout>

                    </LinearLayout>
                </com.synseria.synema.ColumnScroll>
            </LinearLayout>

            <!-- The House panel, as tall as the column (HousePanel): the rooms lit, home.json's tiles, a
                 rule, the rooms (alone scrolling, if need be) and the electricity. Its
                 padding is the room for the lift of what spans it (the electricity): unclipped. -->
            <com.synseria.synema.SidePanel
                android:id="@+id/haPanel"
                android:layout_width="@dimen/house_panel_width"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/syn_espace_2"
                android:layout_marginTop="@dimen/syn_espace_2"
                android:background="@drawable/dash_panel_bg"
                android:orientation="vertical"
                android:padding="@dimen/syn_espace_3"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/syn_espace_1"
                    android:layout_marginEnd="@dimen/syn_espace_1"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:text="@string/house_dashboard"
                        android:textAppearance="@style/Role.Titre" />

                    <TextView
                        android:id="@+id/litRooms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:textAppearance="@style/Role.Note" />
                </LinearLayout>

                <!-- home.json's tiles, fixed; the margins are room for a focused tile's lift (Focus). -->
                <LinearLayout
                    android:id="@+id/tiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/syn_espace_2"
                    android:layout_marginStart="@dimen/syn_espace_1"
                    android:layout_marginEnd="@dimen/syn_espace_1"
                    android:orientation="vertical"
                    android:clipChildren="false" />

                <View
                    android:id="@+id/houseRule"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/syn_trait_filet"
                    android:layout_marginStart="@dimen/syn_espace_2"
                    android:layout_marginEnd="@dimen/syn_espace_2"
                    android:layout_marginTop="@dimen/syn_espace_1"
                    android:background="@color/syn_filet" />

                <!-- The rooms, as tall as they are and no taller than the panel leaves (SidePanel), so the electricity
                     follows them; scrolling alone beyond. Their padding is room for a focused room's lift. -->
                <com.synseria.synema.TileScroll
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/rooms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/syn_espace_1"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false" />
                </com.synseria.synema.TileScroll>

                <!-- The electricity on two lines: the power against the subscription (and its bar) and
                     the month's cost; Tempo's colour today and tomorrow. -->
                <LinearLayout
                    android:id="@+id/tech"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/syn_espace_1"
                    android:layout_marginStart="@dimen/syn_espace_1"
                    android:layout_marginEnd="@dimen/syn_espace_1"
                    android:paddingStart="@dimen/syn_espace_2"
                    android:paddingEnd="@dimen/syn_espace_2"
                    android:paddingTop="@dimen/syn_espace_1"
                    android:paddingBottom="@dimen/syn_espace_1"
                    android:background="@drawable/dash_tech_bg"
                    android:orientation="vertical">

                    <LinearLayout style="@style/TechLine">

                        <TextView
                            android:id="@+id/powerValue"
                            style="@style/TechLabel"
                            android:drawableStart="@drawable/ic_bolt"
                            android:drawablePadding="@dimen/syn_espace_1"
                            android:drawableTint="@color/syn_encre_secondaire"
                            android:textColor="@color/syn_encre" />

                        <TextView
                            android:id="@+id/costValue"
                            style="@style/TechValue" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/powerGauge"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/progress_height"
                        android:layout_marginTop="@dimen/syn_espace_1" />

                    <LinearLayout
                        android:id="@+id/tempoLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/syn_espace_1"
                        android:orientation="vertical">

                        <LinearLayout style="@style/TechLine">

                            <TextView
                                android:id="@+id/tempoTodayLabel"
                                style="@style/TechLabel" />

                            <TextView
                                android:id="@+id/tempoToday"
                                style="@style/TechValue"
                                android:drawablePadding="@dimen/syn_espace_1" />
                        </LinearLayout>

                        <LinearLayout style="@style/TechLine">

                            <TextView
                                android:id="@+id/tempoTomorrowLabel"
                                style="@style/TechLabel" />

                            <TextView
                                android:id="@+id/tempoTomorrow"
                                style="@style/TechValue"
                                android:drawablePadding="@dimen/syn_espace_1" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.synseria.synema.SidePanel>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
