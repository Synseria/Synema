<?xml version="1.0" encoding="utf-8"?>
<!-- The dashboard (MainActivity): the top line (clock, date, readings, status, buttons); on the left,
     the featured title, then scrolling with focus the favourites on their plate, continue watching, what
     the apps put forward and the cameras; the House panel on the right; behind, under the window, the
     background's surface (MovingBackdrop, added in code). Rows are filled in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- The top line, at the clock's height: the time, the date, outside and the TV's room
             (HouseHeader), what is out of the ordinary, then the buttons; under them, the focused
             button's name. Starts where the favourites' pictures do. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:divider="@drawable/dash_column_rule"
                android:showDividers="middle"
                android:dividerPadding="9dp">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFEEF2F8"
                    android:textSize="44sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 200"
                    android:includeFontPadding="false" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextClock
                        style="@style/DashCaps"
                        android:format12Hour="EEEE"
                        android:format24Hour="EEEE" />

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:format12Hour="d MMMM"
                        android:format24Hour="d MMMM"
                        android:textColor="#FFEEF2F8"
                        android:textSize="15sp" />
                </LinearLayout>

                <include
                    android:id="@+id/outside"
                    layout="@layout/dash_climate"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <include
                    android:id="@+id/room"
                    layout="@layout/dash_climate"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Empty when all is calm: a capsule for each thing out of the ordinary, on two lines at most. -->
            <com.synseria.synema.FlowRow
                android:id="@+id/statusChips"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:orientation="horizontal"
                android:background="@drawable/dash_capsule_bg"
                android:divider="@drawable/dash_button_gap"
                android:showDividers="middle"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/btnAssist"
                    style="@style/IconButton"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="@string/assistant" />

                <ImageView
                    android:id="@+id/btnApps"
                    style="@style/IconButton"
                    android:src="@drawable/ic_apps"
                    android:contentDescription="@string/all_apps" />

                <ImageView
                    android:id="@+id/btnInputs"
                    style="@style/IconButton"
                    android:src="@drawable/ic_input"
                    android:contentDescription="@string/inputs" />

                <ImageView
                    android:id="@+id/btnSettings"
                    style="@style/IconButton"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/settings" />

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/topCaption"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="2dp"
            android:paddingEnd="2dp"
            android:gravity="end"
            android:singleLine="true"
            android:textColor="#D9F2F2F5"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Its start margin, and the featured title's, give the column's padding back (MainActivity). -->
        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- The featured title, fixed above the rows: the selected title's artwork and words
                     (MainActivity.feature), else the newest to continue. -->
                <LinearLayout
                    android:id="@+id/hero"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.synseria.synema.RoundedImageView
                        android:id="@+id/heroArt"
                        android:layout_width="199dp"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <!-- The kicker, and at its right the press's and the audience's ratings as small
                             capsules (MainActivity.showRatings), no taller than the kicker: nothing moves
                             when they come. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/heroKicker"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:textAllCaps="true"
                                android:letterSpacing="0.12"
                                android:textColor="#FF8D9BB3"
                                android:textSize="9sp"
                                android:fontFamily="sans-serif-medium" />

                            <LinearLayout
                                android:id="@+id/heroRatings"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/heroTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#FFF4F6FA"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/heroSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#FFC8D2E3"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/heroDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:minLines="2"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingMultiplier="1.1"
                            android:textColor="#FFA9B6CC"
                            android:textSize="10sp" />

                        <FrameLayout
                            android:id="@+id/heroProgress"
                            android:layout_width="160dp"
                            android:layout_height="3dp"
                            android:layout_marginTop="5dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Scrolls by whole sections under the featured title, clipped at its own top edge
                     (ColumnScroll). Its side padding is the room a focused card needs (Focus); the rows'
                     windows reach into it (CardRow), so every picture lines up with the favourites'. -->
                <com.synseria.synema.ColumnScroll
                    android:id="@+id/leftScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:clipChildren="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:clipChildren="false">

                        <!-- Each child is a section the column scrolls to (ColumnScroll): the favourites,
                             then each row with its title. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:clipChildren="false">

                            <!-- Only while a favourite is being moved: how to place it. -->
                            <TextView
                                android:id="@+id/favLabel"
                                style="@style/DashLabel"
                                android:text="@string/edit_moving"
                                android:textColor="#FFF5D90A"
                                android:visibility="gone" />

                            <com.synseria.synema.Dock
                                android:id="@+id/dock"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/dash_dock_bg"
                                android:clipChildren="false"
                                android:clipToPadding="false" />
                        </LinearLayout>

                        <LinearLayout style="@style/DashSection">

                            <TextView
                                android:id="@+id/resumeLabel"
                                style="@style/DashLabel"
                                android:text="@string/continue_watching" />

                            <com.synseria.synema.CardRow
                                android:id="@+id/resumeRow"
                                style="@style/DashRow" />
                        </LinearLayout>

                        <LinearLayout style="@style/DashSection">

                            <TextView
                                android:id="@+id/discoverLabel"
                                style="@style/DashLabel"
                                android:text="@string/discover" />

                            <com.synseria.synema.CardRow
                                android:id="@+id/discoverRow"
                                style="@style/DashRow" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/DashSection"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/camerasLabel"
                                style="@style/DashLabel"
                                android:text="@string/cameras" />

                            <com.synseria.synema.CardRow
                                android:id="@+id/camerasRow"
                                style="@style/DashRow" />
                        </LinearLayout>

                    </LinearLayout>
                </com.synseria.synema.ColumnScroll>
            </LinearLayout>

            <!-- The House panel, as tall as the column (HousePanel): the rooms lit, home.json's tiles, a
                 rule, the rooms (alone scrolling, if need be) and the electricity. Its
                 padding is the room for the lift of what spans it (the electricity): unclipped. -->
            <com.synseria.synema.SidePanel
                android:id="@+id/haPanel"
                android:layout_width="230dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dash_panel_bg"
                android:orientation="vertical"
                android:padding="8dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:text="@string/house_dashboard"
                        android:textColor="#FFF2F2F5"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/litRooms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:textColor="#FFA1A1A6"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- home.json's tiles, fixed; the margins are room for a focused tile's lift (Focus). -->
                <LinearLayout
                    android:id="@+id/tiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:orientation="vertical"
                    android:clipChildren="false" />

                <View
                    android:id="@+id/houseRule"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="1dp"
                    android:background="#1AFFFFFF" />

                <!-- The rooms, scrolling alone; their padding is room for a focused room's lift. -->
                <com.synseria.synema.RoomsScroll
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/rooms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="3dp"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false" />
                </com.synseria.synema.RoomsScroll>

                <!-- The electricity on two lines: the power against the subscription (and its bar) and
                     the month's cost; Tempo's colour today and tomorrow. -->
                <LinearLayout
                    android:id="@+id/tech"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/dash_tech_bg"
                    android:orientation="vertical">

                    <LinearLayout style="@style/TechLine">

                        <TextView
                            android:id="@+id/powerValue"
                            style="@style/TechLabel"
                            android:drawableStart="@drawable/ic_bolt"
                            android:drawablePadding="4dp"
                            android:drawableTint="#A6F2F2F5"
                            android:textColor="#FFF2F2F5" />

                        <TextView
                            android:id="@+id/costValue"
                            style="@style/TechValue" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/powerGauge"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="2dp" />

                    <LinearLayout
                        android:id="@+id/tempoLine"
                        style="@style/TechLine"
                        android:layout_marginTop="4dp">

                        <TextView
                            style="@style/TechLabel"
                            android:text="@string/tech_tempo" />

                        <TextView
                            android:id="@+id/tempoToday"
                            style="@style/TechValue"
                            android:drawablePadding="4dp"
                            android:text="@string/tech_today" />

                        <TextView
                            android:id="@+id/tempoTomorrow"
                            style="@style/TechValue"
                            android:layout_marginStart="10dp"
                            android:drawablePadding="4dp"
                            android:text="@string/tech_tomorrow" />
                    </LinearLayout>
                </LinearLayout>
            </com.synseria.synema.SidePanel>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
