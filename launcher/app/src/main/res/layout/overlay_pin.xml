<?xml version="1.0" encoding="utf-8"?>
<!-- The AirPlay receiver's code over whatever is showing (Alerts.pin): a light card top right where the
     alerts show, its four digits each in a box, readable from the sofa over a dark menu or a film. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="14dp"
    android:background="@drawable/pin_card_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/airplay_code"
        android:textColor="#FF1C1C1E"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/airplay_code_hint"
        android:textColor="#FF6E6E73"
        android:textSize="9.5sp" />

    <LinearLayout
        android:id="@+id/digits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal" />
</LinearLayout>
