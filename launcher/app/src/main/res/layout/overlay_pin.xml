<?xml version="1.0" encoding="utf-8"?>
<!-- The AirPlay receiver's code over whatever is showing (Alerts.pin): a light card top right where the
     alerts show, its four digits each in a box, readable from the sofa over a dark menu or a film. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="@dimen/syn_espace_6"
    android:paddingEnd="@dimen/syn_espace_6"
    android:paddingTop="@dimen/syn_espace_4"
    android:paddingBottom="@dimen/syn_espace_4"
    android:background="@drawable/pin_card_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/airplay_code"
        android:textColor="@color/syn_nuit_profond"
        style="@style/Role.CorpsFort" />

    <LinearLayout
        android:id="@+id/digits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/syn_espace_3"
        android:orientation="horizontal" />
</LinearLayout>
