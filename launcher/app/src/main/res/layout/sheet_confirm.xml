<?xml version="1.0" encoding="utf-8"?>
<!-- "Verb + object?", a detail line when needed, and the buttons at the bottom right: Cancel, then the
     destructive one. Width: jeton manquant: syn_feuille_largeur. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:background="@drawable/sheet_bg"
    android:orientation="vertical"
    android:padding="@dimen/syn_espace_6">

    <TextView
        android:id="@+id/confirm_title"
        style="@style/Role.Titre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/confirm_detail"
        style="@style/Role.Corps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/syn_espace_2"
        android:textColor="@color/syn_encre_secondaire"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/syn_espace_6"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/confirm_cancel"
            style="@style/Role.CorpsFort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_tertiary_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/syn_cible_min"
            android:paddingHorizontal="@dimen/syn_espace_4"
            android:text="@string/action_cancel"
            android:textColor="?attr/syn_primaire_encre" />

        <TextView
            android:id="@+id/confirm_action"
            style="@style/Role.CorpsFort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/syn_espace_2"
            android:background="@drawable/button_danger_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/syn_cible_min"
            android:paddingHorizontal="@dimen/syn_espace_4"
            android:textColor="@color/syn_encre_sur_danger" />
    </LinearLayout>
</LinearLayout>
