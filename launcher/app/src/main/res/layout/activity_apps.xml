<?xml version="1.0" encoding="utf-8"?>
<!-- All apps (AppsActivity): a title and a grid of banners on the dashboard's colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/syn_marge_x"
    android:paddingEnd="@dimen/syn_marge_x"
    android:paddingTop="@dimen/syn_marge_y">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/syn_espace_3"
        android:layout_marginBottom="@dimen/syn_espace_1"
        android:text="@string/all_apps"
        style="@style/Role.TitrePage" />

    <!-- The root clips the grid to this view's bounds: the padding is the room a lifted card and its
         ring need at the edges, the sides' taken from the screen margin above. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/syn_marge_y" />
</LinearLayout>
