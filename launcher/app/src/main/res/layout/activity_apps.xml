<?xml version="1.0" encoding="utf-8"?>
<!-- All apps (AppsActivity): a title and a grid of banners on the dashboard's colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="2dp"
        android:text="@string/all_apps"
        android:textColor="#FFEEF2F8"
        android:textSize="22sp"
        android:fontFamily="sans-serif-light" />

    <!-- The root clips the grid to this view's bounds: the padding is the room a lifted card and its
         ring need at the edges, the sides' taken from the screen margin above. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp" />
</LinearLayout>
