<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): clock, date and the house drifting over the last artwork (MovingBackdrop, added in code). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/syn_tv_fond">

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <!-- The one text outside the roles: a screensaver's clock is read from across the room. jeton manquant: syn_typo_horloge_veille (120sp, graisse 200, interlettre -0.04) -->
            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/syn_encre"
                android:textSize="120sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 200"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/syn_espace_3"
                android:format12Hour="a"
                android:format24Hour=""
                style="@style/Role.Titre"
                android:textColor="@color/syn_encre_secondaire" />
        </LinearLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/syn_espace_2"
            android:layout_marginTop="@dimen/syn_espace_1"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            style="@style/Role.Titre"
            android:textColor="@color/syn_encre_secondaire" />

        <!-- Outside and the TV's room as the top line shows them (HouseHeader.column), larger (ClockDream). The -8dp pulls the first column's plate edge back to the clock: jeton manquant: syn_espace_negatif_2 -->
        <LinearLayout
            android:id="@+id/dreamPlaces"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"
            android:layout_marginTop="@dimen/syn_espace_4"
            android:orientation="horizontal">

            <include
                android:id="@+id/dreamOutside"
                layout="@layout/dash_climate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <include
                android:id="@+id/dreamRoom"
                layout="@layout/dash_climate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <!-- The other rooms' temperatures, then what is out of the ordinary. -->
        <TextView
            android:id="@+id/dreamHouse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/syn_espace_2"
            android:layout_marginTop="@dimen/syn_espace_3"
            style="@style/Role.Corps"
            android:textColor="@color/syn_encre_secondaire"
            android:lineSpacingExtra="@dimen/syn_espace_1" />
    </LinearLayout>
</FrameLayout>
