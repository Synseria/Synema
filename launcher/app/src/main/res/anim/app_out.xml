<?xml version="1.0" encoding="utf-8"?>
<!-- The app left for Home (RemoteKeyService): it draws back and fades under Home settling over it. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="@integer/syn_duree_feuille"
        android:interpolator="@interpolator/syn_courbe" />
    <!-- jeton manquant: syn_depart_echelle (0.9) -->
    <scale android:fromXScale="1" android:toXScale="0.9" android:fromYScale="1" android:toYScale="0.9"
        android:pivotX="50%" android:pivotY="50%" android:duration="@integer/syn_duree_feuille"
        android:interpolator="@interpolator/syn_courbe" />
</set>
