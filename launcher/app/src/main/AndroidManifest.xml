<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Continue watching: other apps' Watch Next rows (WatchNext); granted over adb at install time. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- The assistant listens through the TV's speech recognition; granted over adb at install time. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Orders continue watching by when each app was last used; allowed over adb at install time. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- "Close the app" in the edit menu ends a favourite left in the background. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Android 11+ package visibility: the TV apps it shows, speech recognition and text-to-speech. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.TvHome"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Listed in the TV's own app list, so it can be opened from the stock home screen too. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Every app, opened from the dashboard's "All apps" pill. -->
        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape" />

        <!-- The dashboard's cameras, full screen. -->
        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape" />

        <!-- The house assistant, over whatever is showing: its own task, so the dashboard stays behind. -->
        <activity
            android:name=".AssistActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.TvHome.Overlay"
            android:windowSoftInputMode="adjustPan"
            android:screenOrientation="landscape" />

        <!-- Home button for remotes that send KEYCODE_ALL_APPS (Xiaomi). Opt-in: HOME_KEY_SERVICE=1
             build-and-install.sh; see HomeKeyService. -->
        <service
            android:name=".HomeKeyService"
            android:label="@string/home_key_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>

        <!-- Screensaver: pick it in Settings, or `settings put secure screensaver_components
             com.synseria.synema/.ClockDream` over adb. -->
        <service
            android:name=".ClockDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The remote's Input button (KEYCODE_TV) opens the sources; see InputKeyService. -->
        <service
            android:name=".InputKeyService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/input_key_service" />
        </service>

        <!-- The Assistant button's key layout overlay, offered to the system; see KeyLayouts. -->
        <receiver
            android:name=".KeyLayouts"
            android:exported="true"
            android:label="@string/assistant_key_layout">
            <intent-filter>
                <action android:name="android.hardware.input.action.QUERY_KEYBOARD_LAYOUTS" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.input.metadata.KEYBOARD_LAYOUTS"
                android:resource="@xml/keyboard_layouts" />
        </receiver>

        <!-- The AirPlay receiver's code, read from its notification and shown over any app (AirPlayPin). -->
        <service
            android:name=".AirPlayPin"
            android:exported="true"
            android:label="@string/airplay_code"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Remote buttons reassigned to apps or Home Assistant (keys in res/raw/home.json); see RemoteKeyService. -->
        <service
            android:name=".RemoteKeyService"
            android:exported="false"
            android:label="@string/remote_key_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_key_service" />
        </service>
    </application>
</manifest>
